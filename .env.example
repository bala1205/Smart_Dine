# Copy this file to `.env` and fill in your Firebase project values.
# NEVER commit `.env` — it may contain credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Public origin used to build QR URLs.
# MUST be the production origin (not localhost) so scanned QR codes open the deployed site.
VITE_PUBLIC_URL=https://smart-dine-befb9.web.app

# AI ordering — server-side only (Cloud Functions). NEVER prefix with VITE_ and NEVER commit real keys.
# Voice ordering uses browser Web Speech API for transcription + Groq LLM for intent parsing.
# Groq key format is gsk_... (Groq, not xAI Grok) — keep as GROQ_API_KEY.
# These are read by Firebase Cloud Functions via process.env (functions/.env or secrets).
GROQ_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
